{
  "name": "collector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${COLLECTOR_PORT:-4000}",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p ${COLLECTOR_PORT:-4000}",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:config": "bun scripts/check-config.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.1",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
