{
  "machines": [
    {
      "name": "laptop"
    },
    {
      "name": "vps",
      "ssh": "user@vps-host"
    }
  ],
  "launchd_prefixes": [
    "com.example."
  ],
  "ok_exits": {
    "com.example.weekly-report": {
      "3": "ok (opened a PR)"
    }
  },
  "work_script": {
    "label": "Work script",
    "name": "pickup.py",
    "jobs": [
      "pickup"
    ],
    "log": "~/.hermes/scratch/pickup.log",
    "steps": "~/.work/steps",
    "max_starts_10m": 15
  },
  "verify_label": "my-verify",
  "repos_dir": "~/code",
  "jobs": {
    "pickup": "Reads the board and starts a build or review agent if a card waits",
    "nightly-backup": "Backs up the production database"
  },
  "services": [
    {
      "name": "My app",
      "url": "https://example.com"
    },
    {
      "name": "My API",
      "url": "https://api.example.com/health"
    }
  ],
  "vendors": [
    {
      "name": "GitHub",
      "url": "https://www.githubstatus.com"
    },
    {
      "name": "Vercel",
      "url": "https://www.vercel-status.com"
    }
  ],
  "domains": [
    "example.com"
  ],
  "tickets": {
    "each": [
      "needs-info"
    ],
    "count": [
      "needs-triage"
    ],
    "all": [
      "needs-triage",
      "needs-info",
      "ready-for-agent",
      "code-review"
    ]
  },
  "board": {
    "project_id": "PVT_your-project-node-id",
    "interval": 10,
    "lanes": {
      "needs-triage": "option-id-1",
      "needs-info": "option-id-2",
      "ready-for-agent": "option-id-3",
      "code-review": "option-id-4"
    },
    "priorities": {
      "P0": "option-id-p0",
      "P1": "option-id-p1",
      "P2": "option-id-p2"
    },
    "label_repos": [
      "owner/a-repo-with-lane-labels"
    ]
  },
  "subscriptions": [
    {
      "name": "Hosting",
      "amount": 20,
      "billing": "monthly",
      "currency": "USD"
    },
    {
      "name": "Domain",
      "amount": 12,
      "billing": "annual",
      "currency": "USD"
    }
  ],
  "agent_notes": {
    "builder": "Builds cards",
    "reviewer": "Reviews PRs"
  },
  "billing": {
    "owner/my-app": [
      {
        "provider": "stripe",
        "key": "MYAPP_STRIPE_KEY"
      },
      {
        "provider": "polar",
        "key": "MYAPP_POLAR_TOKEN"
      }
    ]
  }
}
